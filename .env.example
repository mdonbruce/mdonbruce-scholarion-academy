# Scholarion Academy — environment
# Copy to .env.local. Every value here is a sandbox placeholder; nothing is LIVE.

# Public URL used in credential verification links and QR codes
SCHOLARION_PUBLIC_URL=http://localhost:3000

# Persist mock platform state to .data/db.json between restarts (1 = on)
SCHOLARION_PERSIST=1

# Commerce (sandbox placeholders; the product owner sets final prices)
PRICE_PROGRAM_MONTHLY=45
PRICE_PLUS_MONTHLY=55
PRICE_PLUS_ANNUAL=420
TRIAL_DAYS=7
REFUND_DAYS=14
TRIAL_REMINDER_DAYS=2
CURRENCY=USD

# Cloud Lab local runner: runs learner Python on THIS machine with a timeout.
# Development only. The real Cloud Lab runs isolated containers.
CLOUDLAB_LOCAL_RUNNER=1
CLOUDLAB_PYTHON=python3

# Session cookie signing secret (change for any shared environment)
SESSION_SECRET=change-me-in-staging
