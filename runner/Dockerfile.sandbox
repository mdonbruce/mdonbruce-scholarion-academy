# Image every lab-terminal command runs in. It has no secrets and no network at run time
# (the runner always passes --network none). Rebuild it to change the toolset.
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git make jq less \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir pytest==8.3.3 \
 && groupadd -g 1000 learner && useradd -u 1000 -g 1000 -d /tmp -s /bin/sh learner

ENV HOME=/tmp PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /workspace
USER 1000:1000
CMD ["/bin/sh"]
