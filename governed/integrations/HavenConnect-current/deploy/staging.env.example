# HavenConnect staging · havenconnect-stage.oakhavensuites.com
# Set these as hosted SECRETS on the staging site only. Never commit real values.
# Bindings (not secrets): D1 "DB" and R2 "BUCKET" come from .openai/hosting.json.

# Environment label: shows the staging badge and adds noindex (also inferred from the havenconnect-stage host)
HAVEN_ENVIRONMENT=staging

# Who may sign in
# Oak Haven staff (@oakhavensuites.com) always get the staff workspace.
# Platform administrators: manage Apps & Rooms, see every room. Comma separated.
HAVEN_XCONNECT_ADMIN_EMAILS=admin@oakhavensuites.com
HAVEN_CX_EDU_EMAILS=
HAVEN_GRADE_APPROVER_EMAILS=
# Staging only: lets one tester finalize and approve the same grade. Leave blank in production.
HAVEN_GRADE_SINGLE_APPROVER=true

# AI engine (one key is enough)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
AI_PROVIDER=

# Scholaris Global Learning grade sync → point at a Scholaris TEST tenant
SCHOLARIS_API_URL=
SCHOLARIS_API_TOKEN=
SCHOLARIS_TENANT_ID=oakhaven-global-university
SCHOLARIS_API_STYLE=native
ZOOM_ACCESS_TOKEN=
WEBEX_ACCESS_TOKEN=

# Inbound messages from other Haven products (one secret per room you want to test)
HAVEN_INBOUND_SECRET_HAVENUP=
HAVEN_INBOUND_SECRET_HOMEPILOT=

# Communications (optional in staging; features show "not configured" until set)
HAVEN_COMMUNICATIONS_GATEWAY_URL=
HAVEN_COMMUNICATIONS_GATEWAY_TOKEN=
HAVEN_TURN_URL=
HAVEN_TURN_USERNAME=
HAVEN_TURN_CREDENTIAL=
HAVEN_EMAIL_GATEWAY_URL=
