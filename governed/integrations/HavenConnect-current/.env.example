# HavenConnect-owned communications services
HAVEN_COMMUNICATIONS_GATEWAY_URL=
HAVEN_COMMUNICATIONS_GATEWAY_TOKEN=
HAVEN_TURN_URL=
HAVEN_TURN_USERNAME=
HAVEN_TURN_CREDENTIAL=
HAVEN_SIP_GATEWAY_URI=
HAVEN_WHATSAPP_GATEWAY_URL=
HAVEN_WHATSAPP_GATEWAY_TOKEN=
OPENAI_API_KEY=

# Agentic AI (v40)
# AI provider: set one key. With both set, AI_PROVIDER chooses (anthropic | openai).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_PROVIDER=
OPENAI_MODEL=
# Access lists (comma-separated emails)
HAVEN_CX_EDU_EMAILS=
HAVEN_GRADE_APPROVER_EMAILS=
# Set to true only for a one-person staging test; production requires a second approver.
HAVEN_GRADE_SINGLE_APPROVER=
# Scholaris Global Learning grade sync (optional). See SCHOLARIS_GRADE_SYNC.md.
SCHOLARIS_API_URL=
SCHOLARIS_API_TOKEN=
SCHOLARIS_TENANT_ID=oakhaven-global-university
# native (default) = Scholaris grade-submissions API; canvas = Canvas-compatible submissions API on the Scholaris LMS core
SCHOLARIS_API_STYLE=native

# Learning Communications: temporary provider access tokens for a pilot, held only as encrypted Site secrets.
# The corresponding provider connection must be retested after a token expires or rotates.
ZOOM_ACCESS_TOKEN=
WEBEX_ACCESS_TOKEN=
# Outbound email gateway used for applicant reminders and campaigns once tested
HAVEN_EMAIL_GATEWAY_URL=

# Multi-product rooms (v41) · see MULTI_APP.md
# Inbound signing secret per room, e.g. HAVEN_INBOUND_SECRET_HAVENUP, HAVEN_INBOUND_SECRET_SCHOLARIS, HAVEN_INBOUND_SECRET_HOMEPILOT
HAVEN_INBOUND_SECRET_HAVENUP=
# Dedicated databases are D1 bindings (not secrets): DB_SCHOLARIS, DB_OAKHAVEN_GLOBAL_UNIVERSITY, DB_MEDIGRID, DB_HAVEN_TRADING

# Login screen (v42) · staging | production. Inferred from the havenconnect-stage host when blank. See DEPLOY_STAGE.md and deploy/staging.env.example.
HAVEN_ENVIRONMENT=
